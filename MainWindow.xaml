<Window x:Class="WinKit.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit" Width="540" Height="655" MinWidth="480" MinHeight="420" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" ThemeMode="System" FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="WinKit" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="Your Windows essentials, together." Margin="0,6,0,0" Opacity="0.7"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
        <Button x:Name="RefreshButton" Click="RefreshClick" HorizontalAlignment="Right" Padding="9" ToolTip="Check for new utilities and updates" AutomationProperties.Name="Check for updates">
          <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
        </Button>
        <TextBlock x:Name="CheckStatus" FontSize="12" Opacity="0.65" Margin="0,6,0,0" HorizontalAlignment="Right" TextAlignment="Right" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="Choose the utilities you want to keep running." Margin="0,25,0,14" TextWrapping="Wrap"/>
    <TextBlock Grid.Row="2" x:Name="EmptyText" Text="Loading the list of utilities…" Opacity="0.7" Margin="0,4,0,0"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,5,14,0" AutomationProperties.Name="{Binding Name}"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}" Opacity="0.7" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.7" Margin="0,7,0,0" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
    <CheckBox Grid.Row="3" x:Name="StartupCheck" Content="Start WinKit with Windows" Margin="0,14,0,18"/>
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Updates are checked each time this window opens.&#10;Close this window to keep WinKit in the tray." FontSize="12" Opacity="0.65" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
      <Button Grid.Column="1" Content="Apply selection" Click="ApplyClick" Padding="17,9" IsDefault="True" Style="{DynamicResource AccentButtonStyle}"/>
    </Grid>
  </Grid>
</Window>
